# Copy to server/.env (never commit the real file). Development and staging use SYNTHETIC data only.
NODE_ENV=development
PORT=4000

# Application database (created by `createdb patientcase_dev`, or create it in pgAdmin)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/patientcase_dev

# Used only by the test suite to create and drop throw-away databases
# (same server, a database that always exists, e.g. "postgres")
TEST_ADMIN_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# Long random string; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-real-environments

# Optional in development (derived from JWT_SECRET when missing), required in production. 64 hex characters each:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
HASH_KEY=

# Document uploads (optional; these are the defaults). Originals are stored encrypted in FILE_STORE_DIR.
# FILE_STORE_DIR=server/.data
# DOC_MAX_FILES=15
# DOC_MAX_MB=10
# DOC_MAX_PAGES=10

# Hospital system (HIS/EMR) connector. 'mock' only acknowledges (development); production needs 'http' with the hospital's FHIR endpoint.
HIS_MODE=mock
# HIS_URL=https://his.example.hospital/fhir
# HIS_TOKEN=
# Multi-factor sign-in for staff and doctors: on by default in production. Set REQUIRE_MFA=false to switch off (not recommended).
# REQUIRE_MFA=true

# Mock OTP provider and ABDM stub are for development only; production refuses to start with them.
OTP_PROVIDER=mock
ABDM_MODE=stub

# Passwords for the synthetic seed accounts (dev/staging only)
SEED_STAFF_PASSWORD=staff-demo-pass
SEED_DOCTOR_PASSWORD=doctor-demo-pass

# Overview of the patient's history, written after the patient submits. 'rules' (default) restates the record with fixed rules, nothing leaves the platform.
# 'gemini' (uses GEMINI_API_KEY below) or 'anthropic' sends de-identified facts (no name, number or date of birth) to that model; needs hospital and compliance approval first.
AI_PROVIDER=rules
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Interview questions after the reason for the visit. 'rules' (default) uses the fixed branching tree; 'gemini' lets a Google Gemini model
# write each further question from the answers so far (de-identified: no name, number or ID is sent). Needs hospital and compliance
# approval for real patients; the free Gemini tier may use requests to improve Google products. Falls back to the tree on any failure.
AI_INTERVIEW_PROVIDER=rules
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Speech recognition and speech output. 'browser' (default) uses the browser's own speech. 'bhashini' sends the patient's recorded answer (and the
# prompts to be spoken) to Bhashini / AI4Bharat, as the SIH 26047 statement names; it needs ULCA credentials from bhashini.gov.in and
# hospital approval. On any failure the browser's speech takes over. Audio and words are never stored or logged.
SPEECH_PROVIDER=browser
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_CONFIG_URL=
# BHASHINI_INFERENCE_URL=
